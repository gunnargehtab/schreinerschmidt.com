{
  "name": "schreinerschmidt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.8 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:base": "node --env-file=env/pages.env node_modules/astro/bin/astro.mjs dev",
    "build": "node --env-file-if-exists=env/pages.env node_modules/astro/bin/astro.mjs build",
    "build:audit": "node --env-file=env/audit.env node_modules/astro/bin/astro.mjs build",
    "build:assistant": "node --env-file=env/assistant.env node_modules/astro/bin/astro.mjs build",
    "serve": "node --env-file-if-exists=env/pages.env scripts/serve-dist.mjs",
    "check": "astro check",
    "textures": "node scripts/textures/prepare.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:dist": "vitest run --project dist && html-validate \"dist/**/*.html\" && npm run test:budgets",
    "test:dist:audit": "node --env-file=env/audit.env node_modules/vitest/vitest.mjs run --project dist && html-validate \"dist/**/*.html\" && node --env-file=env/audit.env scripts/check-budgets.mjs",
    "test:dist:assistant": "node --env-file=env/assistant.env node_modules/vitest/vitest.mjs run --project dist && html-validate \".cache/dist-assistant/**/*.html\" && node --env-file=env/assistant.env scripts/check-budgets.mjs",
    "test:budgets": "node scripts/check-budgets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:assistant": "node --env-file=env/assistant.env node_modules/@playwright/test/cli.js test --project=chromium --project=no-js assistant",
    "test:assistant": "npm run build:assistant && npm run test:dist:assistant && npm run test:e2e:assistant",
    "test:links": "node --env-file-if-exists=env/pages.env scripts/check-links.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "assets:archive": "node scripts/archive-originals.mjs --from-site",
    "assets:migrate": "node scripts/migrate-assets.mjs",
    "assets:sketches": "node scripts/make-sketch-variants.mjs",
    "assets:wordmark": "node scripts/make-wordmark.mjs",
    "assets:icons": "node scripts/make-icons.mjs",
    "verify": "npm run format:check && npm run check && npm run test:unit && npm run build && npm run test:dist && npm run test:e2e && npm run test:links && npm run test:assistant"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/red-hat-display": "5.3.0",
    "astro": "7.4.1",
    "roughjs": "4.6.6",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "chrome-launcher": "1.2.2",
    "fast-check": "4.10.2",
    "html-validate": "11.16.2",
    "lighthouse": "13.5.0",
    "linkinator": "8.1.0",
    "node-html-parser": "9.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
