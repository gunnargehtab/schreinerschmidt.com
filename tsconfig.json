{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "src", "scripts", "tests", "*.config.*"],
  "exclude": ["dist", "node_modules", ".cache"],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  }
}
