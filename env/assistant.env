# The assistant build: a local, non-public production build whose forms post to the assistant
# backend (decision D3, docs/assistant.md §0), built next to dist/ so the Pages build stays intact.
# `npm run build:assistant` + `npm run test:dist:assistant` + `npm run test:e2e:assistant`
# (docs/architecture.md §11). The endpoint is a reserved .invalid name that never resolves; the e2e
# specs answer it with page.route(). Own port, so a running Pages server is never reused by mistake.
# Like the audit build it still holds the demo placeholders, so the production guard only warns.
SITE=http://localhost:4174
BASE_PATH=/
PORT=4174
PUBLIC_DEMO=false
PUBLIC_ASSISTANT_ENDPOINT=https://anfrage.schreinerei.invalid
DIST_DIR=.cache/dist-assistant
ALLOW_PLACEHOLDERS=true
