SITE=http://localhost:4173
BASE_PATH=/
PUBLIC_DEMO=false
PUBLIC_FORM_ENDPOINT=https://form.taxi/s/audit-placeholder
# The audit build is a local, non-public production build for Lighthouse. It still holds the demo
# placeholders, so the production guard (src/pages/intern/pruefliste/[...demo].astro) only warns
# instead of failing. Never set this for a real production build.
ALLOW_PLACEHOLDERS=true
