{
  "name": "schreinerschmidt-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.8 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "eval": "tsx eval/run.mts",
    "demo": "tsx eval/demo.mts",
    "brief": "node scripts/build-brief.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.13",
    "nodemailer": "10.0.16",
    "pdf-lib": "1.17.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
