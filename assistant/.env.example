# Backend configuration (docs/angebot.md §10). Names only, no values: copy to .env (git-ignored)
# for local use, or set them in the host's secret store. In NODE_ENV=production the values marked
# "required" must be set, or the process refuses to start.

# development | test | production (default: development)
NODE_ENV=
# Listen address and port (defaults: 127.0.0.1, 8787)
HOST=
PORT=

# Backend origin for links in mails, e.g. https://anfrage.<domain> (required in production)
PUBLIC_BASE_URL=
# The site's origin: the only allowed Origin of POST /anfrage and of _next (required in production)
SITE_ORIGIN=
# The site's base path on SITE_ORIGIN, the redirect fallback (default: /)
SITE_BASE=

# Recipient of enquiries and TL;DR mails (required in production)
OWNER_EMAIL=
# Sender of every mail, e.g. "Schreinerei Schmidt <anfrage@<domain>>" (required in production)
MAIL_FROM=

# dry-run | allowlist | live (default dry-run; required in production)
SEND_MODE=
# Comma-separated customer addresses that may receive mail in allowlist mode
SEND_ALLOWLIST=

# SMTP submission (required for allowlist and live; port 465 = implicit TLS, else STARTTLS)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Data directory for angebote.sqlite and the dry-run outbox (default ./data; required in production)
DATA_DIR=
# Review-link validity in days (default 14; used from phase 7d)
TOKEN_TTL_DAYS=
# Optional review-page PIN (phase 7d)
OWNER_PIN=
# Claude API key (phase 7c)
ANTHROPIC_API_KEY=
# 1 behind a reverse proxy: the rate limit keys on the last X-Forwarded-For hop (default 0)
TRUST_PROXY=
