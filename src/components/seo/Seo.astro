---
// Head tags for SEO and sharing (docs/architecture.md §7). Renders inside <head>.
// Titles and descriptions are validated at build time; indexing follows the build mode.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { PUBLIC_DEMO } from 'astro:env/client';
import { DEFAULT_OG_IMAGE } from '../../lib/og-default';
import { assertDescription, buildTitle, indexing, isAlwaysNoindex, ogImage, OG_LOCALE, SITE_NAME } from '../../lib/seo';

interface Props {
  /** Page part of the title; omit on Home for the fixed home title. */
  title?: string | undefined;
  /** 110–158 characters on indexable pages. */
  description: string;
  /** Force noindex (danke pages, 404 and /intern/ are detected automatically). */
  noindex?: boolean | undefined;
  /** Canonical target pathname incl. base, if not this page (e.g. url('konfigurator/')). */
  canonicalPath?: string | undefined;
  /** Page hero for og:image (cropped to 1200×630); defaults to DEFAULT_OG_IMAGE. */
  image?: { src: ImageMetadata; alt: string } | undefined;
  type?: 'website' | 'article' | undefined;
}

const { title, description, noindex = false, canonicalPath, image = DEFAULT_OG_IMAGE, type = 'website' } = Astro.props;
const site = Astro.site;
if (!site) throw new Error('Seo: `site` must be set in astro.config.mjs');

const fullTitle = buildTitle(title);
const seo = indexing({ demo: PUBLIC_DEMO, pathname: Astro.url.pathname, site, noindex, canonicalPath });
// Length rules apply to every page that could be indexed in production, also in demo builds.
const checkable = !noindex && !isAlwaysNoindex(Astro.url.pathname);
const desc = checkable ? assertDescription(description) : description.trim();
const pageUrl = seo.canonical ?? new URL(Astro.url.pathname, site).href;
const og = await ogImage(getImage, { src: image.src, alt: image.alt, site });
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<meta name="robots" content={seo.robots} />
{seo.canonical && <link rel="canonical" href={seo.canonical} />}
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={OG_LOCALE} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={og.url} />
<meta property="og:image:type" content={og.type} />
<meta property="og:image:width" content={String(og.width)} />
<meta property="og:image:height" content={String(og.height)} />
<meta property="og:image:alt" content={og.alt} />
<meta name="twitter:card" content="summary_large_image" />
