---
// Wraps text that is not confirmed yet. Plain by default; with `?pruefen` in the URL the text is
// highlighted and a legend explains the marks (owner review view, docs/owner-checklist.md).
//
// The `?pruefen` switch is ui/ReviewView.astro, rendered once per page by BaseLayout (CSS `:has()`
// can't read the URL). It isn't a <script> here: Astro renders a component's script where the
// component first appears, which may be inside a `tel:` link. Without JS the text renders plain,
// which is the right default for visitors.
// Styles: src/styles/components/review.css (global: shared, also used by HTML-string marks).
interface Props {
  status?: 'needs-review' | 'placeholder';
  /** Short note for the owner, shown as the tooltip in review view. */
  note?: string | undefined;
}

const { status = 'needs-review', note } = Astro.props;
// The slot is pre-rendered and injected so the span carries no template whitespace (Prettier would
// wrap `<slot />` onto its own line) and no `<!-- prettier-ignore -->` comment: both would end up
// inside `<a href="tel:">` wrappers and break html-validate's tel-non-breaking rule.
const content = await Astro.slots.render('default');
---

<span class="review-mark" data-review={status} title={note} set:html={content} />
