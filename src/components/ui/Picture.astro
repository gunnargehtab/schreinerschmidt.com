---
// Thin wrapper around astro:assets <Picture>: AVIF + WebP with the source format as fallback.
import { Picture as AstroPicture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** Required. Use "" only for purely decorative images. */
  alt: string;
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Display width in CSS px (constrained layout: srcset goes up to 2x this width). */
  width?: number;
  /** With `width`: crops every rendition to this aspect ratio (fit cover), e.g. 4:3 card thumbnails. */
  height?: number;
  widths?: number[];
  class?: string;
}

const {
  src,
  alt,
  sizes: sizesProp,
  loading = 'lazy',
  fetchpriority,
  width,
  height,
  widths,
  class: className,
} = Astro.props;
// Lazy images get `sizes="auto, …"` (docs/design-system.md §7): the browser picks the candidate for
// the laid-out width instead of the (often wider) media-query estimate. Eager images can't use it.
const sizes = loading === 'lazy' && !/^\s*auto\b/.test(sizesProp) ? `auto, ${sizesProp}` : sizesProp;

const optional = {
  ...(fetchpriority ? { fetchpriority } : {}),
  ...(width ? { width } : {}),
  ...(width && height ? { height } : {}),
  ...(widths ? { widths } : {}),
  ...(className ? { class: className } : {}),
};
---

<AstroPicture
  src={src}
  alt={alt}
  sizes={sizes}
  loading={loading}
  decoding={loading === 'eager' ? 'auto' : 'async'}
  formats={['avif', 'webp']}
  {...optional}
/>
