---
// Thin wrapper around astro:assets <Picture>: AVIF + WebP with the source format as fallback.
import { Picture as AstroPicture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** Required. Use "" only for purely decorative images. */
  alt: string;
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Display width in CSS px (constrained layout: srcset goes up to 2x this width). */
  width?: number;
  widths?: number[];
  class?: string;
}

const { src, alt, sizes, loading = 'lazy', fetchpriority, width, widths, class: className } = Astro.props;

const optional = {
  ...(fetchpriority ? { fetchpriority } : {}),
  ...(width ? { width } : {}),
  ...(widths ? { widths } : {}),
  ...(className ? { class: className } : {}),
};
---

<AstroPicture
  src={src}
  alt={alt}
  sizes={sizes}
  loading={loading}
  decoding={loading === 'eager' ? 'auto' : 'async'}
  formats={['avif', 'webp']}
  {...optional}
/>
