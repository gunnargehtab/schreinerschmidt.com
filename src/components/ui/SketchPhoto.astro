---
// Sketch → photo reveal (docs/design-system.md §3 "Sketch → photo"). Below the fold ONLY: the
// photo is the finished state and is never the LCP image; its opacity is never animated. The
// pencil variant lies on top and fades out on a view timeline while the photo settles from a
// slight scale (motion.css). Without scroll-driven animations or with reduced motion the sketch
// layer is not displayed at all. The sketch is decorative; the photo carries the alt.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Picture from './Picture.astro';

interface Props {
  photo: ImageMetadata;
  /** Pixel-aligned pencil variant from scripts/make-sketch-variants.mjs (src/assets/sketches). */
  sketch: ImageMetadata;
  alt: string;
  sizes: string;
  /** Display width in CSS px (constrained layout). */
  width?: number;
  class?: string;
}

const { photo, sketch, alt, sizes, width, class: className } = Astro.props;
if (sketch.width !== photo.width || sketch.height !== photo.height) {
  throw new Error(
    `SketchPhoto: sketch (${sketch.width}×${sketch.height}) must match the photo (${photo.width}×${photo.height})`,
  );
}
const sizing = width ? { width } : {};
---

<div class:list={['sketch-photo', className]} style={`--ar: ${photo.width} / ${photo.height}`}>
  <Picture class="sketch-photo__img" src={photo} alt={alt} sizes={sizes} loading="lazy" {...sizing} />
  <Image class="sketch-photo__sketch" src={sketch} alt="" sizes={sizes} loading="lazy" decoding="async" {...sizing} />
</div>
