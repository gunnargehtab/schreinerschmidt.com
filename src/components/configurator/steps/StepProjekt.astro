---
// Step 1: Projekt (docs/configurator.md §1 "Step 1: typ"). Eight radio cards with a line icon each;
// `typ` is required in the HTML. Path deep links (konfigurator/<typ>/) pass `checked`, so the
// matching radio is checked in the HTML and :has() reveals its branch without JS.
// The icons are the `projekt-<typ>` entries of the hand-drawn UI icon set (src/lib/sketch/icons.ts).
import { PROJECT_TYPES } from '../../../lib/configurator/conditions';
import { FIELDS, type ProjectType } from '../../../lib/configurator/fields';
import { LABELS, PROJECT_TYPE_LABELS } from '../../../lib/configurator/labels';
import type { KonfiguratorCopy } from '../../../lib/page-copy/konfigurator';
import { ICONS } from '../../../lib/sketch/icons';
import RadioCards from '../fields/RadioCards.astro';
import StepFrame from './StepFrame.astro';

interface Props {
  copy: KonfiguratorCopy;
  /** Project type that is checked in the HTML (path deep link). */
  typ?: ProjectType | undefined;
}

const { copy, typ } = Astro.props;

const options = PROJECT_TYPES.map((value) => ({
  value,
  label: PROJECT_TYPE_LABELS[value].label,
  hint: PROJECT_TYPE_LABELS[value].hint,
  icon: ICONS[`projekt-${value}`],
}));
---

<StepFrame id="projekt" copy={copy}>
  <RadioCards
    name="typ"
    legend={LABELS['typ']?.label ?? 'Projektart'}
    options={options}
    layout="cards"
    required={FIELDS['typ']?.required}
    checked={typ}
  />
</StepFrame>
