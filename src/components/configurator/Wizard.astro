---
// Quote wizard shell: the complete no-JS form and the DOM contract the JS enhancement builds on
// (docs/configurator.md §1, §2, §3, §5; design-system §8 "Konfigurator shell").
//
// ============================== DOM CONTRACT ==============================
// Root   <section class="configurator graph-paper" data-configurator data-mode="demo|live"
//          data-msg-*="...">   The data-msg-* attributes carry the runtime strings of the copy
//        (announcements, error lines, templates with {tokens}) so the client bundle holds no German
//        copy of its own. Keys: type-preselected, type-switched, draft-saved, draft-deleted,
//        link-copied, summary-copied, viewer-loading, viewer-ready, viewer-unavailable, offline,
//        already-sent, already-sent-confirm, already-sent-cancel, step-heading ("Schritt {n} von
//        {total}: {title}"), step-of, compact, edit, link-copied-label, photo-remove.
// Form   <form id="anfrage" class="wizard" autocomplete="off">
//          demo: method="dialog" + a visible demo note ([data-demo-note] in step pruefen, ribbon on top).
//          live: method="post" action=FORM_ENDPOINT enctype="multipart/form-data" with hidden
//                _subject, _replyto (empty), _lang=de, _next (absolute URL of konfigurator/danke/),
//                MAX_FILE_SIZE and empty anfrage_id, anfrage_json, zusammenfassung. Demo: none of them.
//          The honeypot (Honeypot component, name "homepage") is the last child before the step nav.
// Steps  <section class="step" data-step="projekt|details|ausfuehrung|rahmen|kontakt|pruefen"
//          aria-labelledby="h-<id>"> with <h2 id="h-<id>" tabindex="-1">: [data-step-prefix] "Schritt n:"
//          + [data-title] or, for details/ausfuehrung, [data-title-moebel] / [data-title-other] (shown by
//          :has() on the checked typ; without JS the generic title). [data-intro-generic] is the
//          fallback intro of steps 2 and 3 (hidden once a typ is checked).
// Branch <fieldset class="branch" data-branch="<typ>"> (+ <fieldset data-branch data-field="fotos[]">
//          for photos, unique ids f-fotos-<typ>; Möbel preview <figure data-preview data-branch="moebel">).
//        data-when="<condition id>" sits on the wrapper of the conditional field (a <fieldset> for
//          groups, a <div class="field"> for single controls) or, for OPTION_WHEN, on the option's
//          <label class="choice">. JS toggles `disabled` on the controls of a <div>/<label> itself.
//        Hide rules: dist/konfigurator/bedingungen.css (:has() on [name=typ] / [name=<field>] :checked).
// Field  .field[data-field="<name>"][data-label="<visible label>"][data-unit?][data-when?]
//          label/legend inside; error slot <p id="f-<name>-fehler" class="field__error" hidden>;
//          hint <p id="f-<name>-hint">. Ids: single controls f-<name>, options f-<name>-<value>.
//          `required` only on typ/plz/name/email. `data-required` (empty) on every control of a
//          required:'js' field; on a checkbox group (fenster_leistung, altbau_bereiche) it is
//          data-required="group" on the fieldset (JS enforces "at least one"). Radios of branches
//          carry no `checked`; number inputs carry a placeholder, never a value. Boolean checkboxes
//          have value="1". Checkbox groups keep ONE plain name (no "[]"), because conditions.ts
//          matches [name="..."]; html-validate's form-dup-name is disabled around them.
//        NumberRange: the number input has the name; <input type="range" hidden data-range-for="<name>"
//          aria-label="<Label> (Schieberegler)"> (no name) follows it; JS reveals and syncs it.
// Hidden tisch_brett is <input type="hidden" name="tisch_brett"> (live-edge seed).
// Rahmen <output id="einzugsgebiet" for="f-plz" aria-live="polite" data-service-area>
// Progress <nav class="progress" data-progress hidden> (hidden without JS: the page is one long form),
//        <ol> with <li data-step-link="<id>"><button data-goto="<id>">; [data-done] hidden text
//        "abgeschlossen"; [data-progress-compact] for "2/6".
// Nav    <div class="step-nav" data-step-nav hidden> with [data-action="back"] / [data-action="next"].
//        The submit button <button type="submit" data-action="submit"> (step pruefen) precedes it in the DOM.
// Errors <div class="error-summary" data-error-summary tabindex="-1" hidden> with an empty <ul data-error-list>;
//        live mode: <div role="alert" data-submit-error hidden> with [data-reason=network|timeout|rejected|offline]
//        lines and [data-action=retry|mail|copy] buttons.
// Live   <div data-live="polite" aria-live="polite"> and <div data-live="assertive" aria-live="assertive">
//        (both .visually-hidden).
// Review <div data-review-summary hidden><dl data-review-list></dl></div> in step pruefen.
// Aside  <aside aria-labelledby="h-auswahl" data-summary hidden> (outside the form): [data-draft-banner]
//        ([data-draft-date], [data-action=draft-resume|draft-discard]), <details data-summary-details>
//        with [data-summary-count], [data-summary-empty], <dl data-summary-list>; share button
//        (popovertarget="share-popover", [data-action=share]) + popover#share-popover ([data-share-url],
//        [data-action=copy-link]); draft checkbox [data-draft-toggle] (no name, never submitted) and
//        [data-action=draft-delete]. No pricing box (pricing is disabled).
// Success <section data-success hidden tabindex="-1" aria-labelledby="h-erfolg"> outside the form:
//        h2#h-erfolg (demo/live variant chosen at build time), [data-anfrage-id], [data-success-summary],
//        [data-success-drawing], [data-action=mail|copy|save|print|link] (all hidden), the timeline.
// Preview figure[data-preview] > [data-preview-drawing] (build-time SVG) + [data-viewer] hidden, caption.
// ==========================================================================
import { getEntry } from 'astro:content';
import type { ProjectType } from '../../lib/configurator/fields';
import { FORM_ID } from '../../lib/configurator/conditions';
import { getPageCopy } from '../../lib/page-copy';
import { konfiguratorSchema } from '../../lib/page-copy/konfigurator';
import { absolute, url } from '../../lib/url';
import ErrorSummary from '../forms/ErrorSummary.astro';
import Honeypot from '../forms/Honeypot.astro';
import { FORM_ENDPOINT, formMode } from '../forms/mode';
import Progress from './Progress.astro';
import SuccessTimeline from './SuccessTimeline.astro';
import SummarySidebar from './SummarySidebar.astro';
import StepAusfuehrung from './steps/StepAusfuehrung.astro';
import StepDetails from './steps/StepDetails.astro';
import StepKontakt from './steps/StepKontakt.astro';
import StepProjekt from './steps/StepProjekt.astro';
import StepPruefen from './steps/StepPruefen.astro';
import StepRahmen from './steps/StepRahmen.astro';

interface Props {
  /** Project type that is checked in the HTML (path deep link konfigurator/<typ>/). */
  typ?: ProjectType | undefined;
}

const { typ } = Astro.props;
const copy = await getPageCopy('konfigurator', konfiguratorSchema);
const site = (await getEntry('settings', 'site'))?.data;
if (!site) throw new Error('Wizard: settings entry "site" is missing');
if (!Astro.site) throw new Error('Wizard: `site` is not configured');

const mode = formMode();
const live = mode === 'live';
if (live && !FORM_ENDPOINT?.startsWith('https://')) {
  throw new Error('Wizard: live mode needs an https PUBLIC_FORM_ENDPOINT');
}

// 10 MB per photo (docs/configurator.md photo policy); form.taxi reads MAX_FILE_SIZE.
const MAX_FILE_SIZE = 10 * 1024 * 1024;

const formAttrs = live
  ? { method: 'post', action: FORM_ENDPOINT, enctype: 'multipart/form-data' }
  : { method: 'dialog' };

// Runtime strings for the client, read from the DOM instead of duplicating German copy in JS.
const messages: Record<string, string> = {
  'type-preselected': copy.announce.typePreselected,
  'type-switched': copy.announce.typeSwitched,
  'draft-saved': copy.announce.draftSaved,
  'draft-deleted': copy.announce.draftDeleted,
  'link-copied': copy.announce.linkCopied,
  'summary-copied': copy.announce.summaryCopied,
  'viewer-loading': copy.announce.viewer.loading,
  'viewer-ready': copy.announce.viewer.ready,
  'viewer-unavailable': copy.announce.viewer.unavailable,
  offline: copy.errors.offline,
  'already-sent': copy.errors.alreadySent.text,
  'already-sent-confirm': copy.errors.alreadySent.confirm,
  'already-sent-cancel': copy.errors.alreadySent.cancel,
  'step-heading': copy.progress.heading,
  'step-of': copy.progress.stepOf,
  compact: copy.progress.compact,
  edit: copy.summary.edit,
  'link-copied-label': copy.summary.share.copied,
  'photo-remove': copy.photos.remove,
};
const dataMsg = Object.fromEntries(Object.entries(messages).map(([k, v]) => [`data-msg-${k}`, v]));

const [idBefore = '', idAfter = ''] = copy.success.idLine.split('{id}');
const actions = copy.success.actions;
---

<section class="section section--compact configurator graph-paper" data-configurator data-mode={mode} {...dataMsg}>
  <div class="configurator__layout">
    <div class="configurator__main">
      <Progress copy={copy} />
      {!live && <p class="configurator__ribbon">{copy.demo.ribbon}</p>}
      <p class="configurator__nojs no-js-only">{copy.nojs.intro}</p>
      <form id={FORM_ID} class="wizard" autocomplete="off" {...formAttrs}>
        <ErrorSummary id={`${FORM_ID}-fehler`} title={copy.errors.summaryTitle} />
        {live && (
          <>
            <input type="hidden" name="_subject" value="Anfrage über den Konfigurator" />
            <input type="hidden" name="_replyto" value="" />
            <input type="hidden" name="_lang" value="de" />
            <input type="hidden" name="_next" value={absolute(url('konfigurator/danke/'), Astro.site)} />
            <input type="hidden" name="MAX_FILE_SIZE" value={MAX_FILE_SIZE} />
            <input type="hidden" name="anfrage_id" value="" />
            <input type="hidden" name="anfrage_json" value="" />
            <input type="hidden" name="zusammenfassung" value="" />
          </>
        )}
        <StepProjekt copy={copy} typ={typ} />
        <StepDetails copy={copy} email={site.email} live={live} />
        <StepAusfuehrung copy={copy} email={site.email} live={live} />
        <StepRahmen copy={copy} />
        <StepKontakt copy={copy} />
        <StepPruefen copy={copy} live={live} />
        <Honeypot id={`${FORM_ID}-hp`} />
        <div class="step-nav" data-step-nav hidden>
          <button class="btn btn--secondary" type="button" data-action="back">
            {copy.nav.back}
          </button>
          <button class="btn" type="button" data-action="next">
            {copy.nav.next}
          </button>
        </div>
      </form>
      <div class="visually-hidden" data-live="polite" aria-live="polite"></div>
      <div class="visually-hidden" data-live="assertive" aria-live="assertive"></div>
    </div>
    <SummarySidebar copy={copy} />
  </div>
  <section class="success paper" data-success hidden tabindex="-1" aria-labelledby="h-erfolg">
    <h2 class="success__title" id="h-erfolg">
      {live ? copy.success.h2 : copy.success.h2Demo}
    </h2>
    <p>{live ? copy.success.text : copy.success.textDemo}</p>
    <p class="success__id">
      {idBefore}
      <strong data-anfrage-id></strong>
      {idAfter}
    </p>
    <div class="success__body">
      <div class="success__summary" data-success-summary></div>
      <div class="success__drawing" data-success-drawing></div>
    </div>
    <div class="cluster success__actions">
      <button class="btn btn--small" type="button" data-action="mail" hidden>
        {actions.mail}
      </button>
      <button class="btn btn--secondary btn--small" type="button" data-action="copy" hidden>
        {actions.copy}
      </button>
      <button class="btn btn--secondary btn--small" type="button" data-action="save" hidden>
        {actions.save}
      </button>
      <button class="btn btn--secondary btn--small" type="button" data-action="print" hidden>
        {actions.print}
      </button>
      <button class="btn btn--secondary btn--small" type="button" data-action="link" hidden>
        {actions.link}
      </button>
    </div>
    <SuccessTimeline timeline={copy.success.timeline} />
  </section>
</section>

<script>
  import '../../scripts/configurator/main';
</script>
