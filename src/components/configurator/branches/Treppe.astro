---
// Treppe: branch of the quote wizard (docs/configurator.md §1). A list of field names; FieldControl
// renders each one from fields.ts + labels.ts. `step` picks the fields of step 2 (details) or
// step 3 (ausfuehrung, with the photos). The fieldset carries `data-branch`, so it is hidden by the
// generated :has() rules until the project type is chosen.
import { PROJECT_TYPE_LABELS } from '../../../lib/configurator/labels';
import type { KonfiguratorCopy } from '../../../lib/page-copy/konfigurator';
import FieldControl from '../fields/FieldControl.astro';
import Fotos from './Fotos.astro';

interface Props {
  step: 'details' | 'ausfuehrung';
  /** Intro line of this branch and step (copy: steps.<step>.intros.treppe). */
  intro: string;
  photos: KonfiguratorCopy['photos'];
  email: string;
  live: boolean;
}

const { step, intro, photos, email, live } = Astro.props;
---

<fieldset class="branch" data-branch="treppe">
  <legend class="visually-hidden">{PROJECT_TYPE_LABELS.treppe.label}</legend>
  <p class="step__intro">{intro}</p>
  {step === 'details' && (
    <>
      <FieldControl name="treppe_leistung" />
      <FieldControl name="treppe_form" />
      <FieldControl name="treppe_geschosshoehe" />
      <FieldControl name="treppe_stufen" />
      <FieldControl name="treppe_holz" />
    </>
  )}
  {step === 'ausfuehrung' && (
    <>
      <FieldControl name="treppe_bauart" />
      <FieldControl name="treppe_bestand" />
      <FieldControl name="treppe_gelaender" />
      <FieldControl name="treppe_zustand" />
    </>
  )}
</fieldset>
{step === 'ausfuehrung' && <Fotos typ="treppe" photos={photos} email={email} live={live} />}
