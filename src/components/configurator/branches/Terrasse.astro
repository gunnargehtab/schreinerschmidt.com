---
// Terrasse & Zaun: branch of the quote wizard (docs/configurator.md §1). A list of field names; FieldControl
// renders each one from fields.ts + labels.ts. `step` picks the fields of step 2 (details) or
// step 3 (ausfuehrung, with the photos). The fieldset carries `data-branch`, so it is hidden by the
// generated :has() rules until the project type is chosen.
import { PROJECT_TYPE_LABELS } from '../../../lib/configurator/labels';
import type { KonfiguratorCopy } from '../../../lib/page-copy/konfigurator';
import FieldControl from '../fields/FieldControl.astro';
import Fotos from './Fotos.astro';

interface Props {
  step: 'details' | 'ausfuehrung';
  /** Intro line of this branch and step (copy: steps.<step>.intros.terrasse). */
  intro: string;
  photos: KonfiguratorCopy['photos'];
  email: string;
  live: boolean;
}

const { step, intro, photos, email, live } = Astro.props;
---

<fieldset class="branch" data-branch="terrasse">
  <legend class="visually-hidden">{PROJECT_TYPE_LABELS.terrasse.label}</legend>
  <p class="step__intro">{intro}</p>
  {step === 'details' && (
    <>
      <FieldControl name="terrasse_was" />
      <FieldControl name="terrasse_flaeche" />
      <FieldControl name="terrasse_holz" />
      <FieldControl name="zaun_laenge" />
      <FieldControl name="zaun_hoehe" />
      <FieldControl name="zaun_tore" />
    </>
  )}
  {step === 'ausfuehrung' && (
    <>
      <FieldControl name="terrasse_untergrund" />
      <FieldControl name="terrasse_hoehe" />
      <FieldControl name="zaun_hang" />
    </>
  )}
</fieldset>
{step === 'ausfuehrung' && <Fotos typ="terrasse" photos={photos} email={email} live={live} />}
