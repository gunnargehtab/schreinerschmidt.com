---
// Türen: branch of the quote wizard (docs/configurator.md §1 "Tür"). A list of field names; see
// Boden.astro. tuer_anschlag gets the explainer popover for DIN links/rechts (`popovertarget`, works
// without JS); tuer_zustand gets the link to the before/after example (the Haustür project with a
// `beforeAfter` pair and a detail page; the link is omitted if that project loses either).
// The branch copy (`tuer` block) is read here the way Wizard.astro reads the shell copy, so the step
// components keep passing the shared branch props only.
import { PROJECT_TYPE_LABELS } from '../../../lib/configurator/labels';
import { getProject } from '../../../lib/content';
import { getPageCopy } from '../../../lib/page-copy';
import { konfiguratorSchema } from '../../../lib/page-copy/konfigurator';
import type { KonfiguratorCopy } from '../../../lib/page-copy/konfigurator';
import { marked } from '../../../lib/review-mark';
import { url } from '../../../lib/url';
import ReviewMark from '../../ui/ReviewMark.astro';
import FieldControl from '../fields/FieldControl.astro';
import Fotos from './Fotos.astro';

interface Props {
  step: 'details' | 'ausfuehrung';
  /** Intro line of this branch and step (copy: steps.<step>.intros.tuer). */
  intro: string;
  photos: KonfiguratorCopy['photos'];
  email: string;
  live: boolean;
}

const { step, intro, photos, email, live } = Astro.props;

/** The reference with the before/after pair of a Haustür (same project Home shows). */
const EXAMPLE_SLUG = 'holzhaustuer-aufgearbeitet';
const [{ tuer }, example] = await Promise.all([
  getPageCopy('konfigurator', konfiguratorSchema),
  getProject(EXAMPLE_SLUG),
]);
const exampleHref =
  example?.data.beforeAfter && example.data.detailPage ? url(`referenzen/${EXAMPLE_SLUG}/`) : undefined;
const exampleStatus = marked(tuer.vorherNachher);
---

<fieldset class="branch" data-branch="tuer">
  <legend class="visually-hidden">{PROJECT_TYPE_LABELS.tuer.label}</legend>
  <p class="step__intro">{intro}</p>
  {step === 'details' && (
    <>
      <FieldControl name="tuer_art" />
      <FieldControl name="tuer_anzahl" />
      <FieldControl name="tuer_breite" />
      <FieldControl name="tuer_hoehe" />
      <FieldControl name="tuer_anschlag" />
      <div class="explainer">
        <button type="button" class="btn btn--ghost btn--small" popovertarget="din-erklaerung">
          {tuer.din.trigger}
        </button>
        <div
          id="din-erklaerung"
          class="explainer__popover"
          popover
          role="dialog"
          aria-labelledby="din-erklaerung-titel"
        >
          <h3 id="din-erklaerung-titel" class="explainer__title">
            {tuer.din.heading}
          </h3>
          <p>{tuer.din.text}</p>
          <button
            type="button"
            class="btn btn--secondary btn--small"
            popovertarget="din-erklaerung"
            popovertargetaction="hide"
          >
            {tuer.din.close}
          </button>
        </div>
      </div>
    </>
  )}
  {step === 'ausfuehrung' && (
    <>
      <FieldControl name="tuer_sicherheit" />
      <FieldControl name="tuer_glas" />
      <FieldControl name="tuer_stil" />
      <FieldControl name="tuer_zustand" />
      {exampleHref && (
        <p class="field__hint">
          {exampleStatus ? (
            <ReviewMark status={exampleStatus} note={tuer.vorherNachher.note}>
              <a href={exampleHref}>{tuer.vorherNachher.label}</a>
            </ReviewMark>
          ) : (
            <a href={exampleHref}>{tuer.vorherNachher.label}</a>
          )}
        </p>
      )}
    </>
  )}
</fieldset>
{step === 'ausfuehrung' && <Fotos typ="tuer" photos={photos} email={email} live={live} />}
