---
// Key facts as a description list (Ort, Jahr, Holz …), docs/design-system.md §5. Terms on top of
// values on a hairline grid; entries without a value are dropped, so optional fields need no checks.
import ReviewMark from '../ui/ReviewMark.astro';

interface Fact {
  label: string;
  value: string | undefined;
  /** Set for unconfirmed values; marks them in the review view. */
  review?: 'needs-review' | 'placeholder';
}

interface Props {
  facts: readonly Fact[];
}

const facts = Astro.props.facts.filter((f): f is Fact & { value: string } => Boolean(f.value));
---

{facts.length > 0 && (
  <dl class="fact-list hairline-grid">
    {facts.map((fact) => (
      <div class="fact-list__item">
        <dt>{fact.label}</dt>
        <dd>{fact.review ? <ReviewMark status={fact.review}>{fact.value}</ReviewMark> : fact.value}</dd>
      </div>
    ))}
  </dl>
)}

<style>
  @layer components {
    .fact-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
      margin: 0;
    }

    .fact-list__item {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 2;
      gap: var(--space-3xs);
      padding: var(--space-xs) var(--space-s);
    }

    .fact-list dt {
      font-size: var(--step--1);
      color: var(--ink-muted);
    }

    .fact-list dd {
      margin: 0;
      font-weight: var(--weight-ui);
      overflow-wrap: anywhere;
    }
  }
</style>
