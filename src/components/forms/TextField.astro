---
// Single-line input inside a <Field>. `preset` applies the attributes of the fields table in
// docs/architecture.md §8 (name, email, tel, plz, ort) plus a default label and error text.
import type { HTMLAttributes } from 'astro/types';
import Field from './Field.astro';
import { describedBy } from './mode';
import { defaultMessage } from '../../scripts/forms/messages.de';

type Preset = 'name' | 'email' | 'tel' | 'plz' | 'ort';

interface Props {
  name: string;
  /** Defaults to the preset's label ("Name", "E-Mail", "Telefon", "PLZ", "Ort"). */
  label?: string;
  id?: string;
  preset?: Preset;
  type?: 'text' | 'email' | 'tel' | 'url' | 'search';
  required?: boolean;
  hint?: string;
  error?: string;
  autocomplete?: HTMLAttributes<'input'>['autocomplete'];
  inputmode?: HTMLAttributes<'input'>['inputmode'];
  pattern?: string;
  minlength?: number;
  maxlength?: number;
  placeholder?: string;
  value?: string;
  requiredText?: string;
  class?: string;
}

const PRESETS: Record<Preset, { label: string; attrs: HTMLAttributes<'input'> }> = {
  name: { label: 'Name', attrs: { type: 'text', autocomplete: 'name' } },
  email: { label: 'E-Mail', attrs: { type: 'email', autocomplete: 'email', spellcheck: 'false' } },
  tel: { label: 'Telefon', attrs: { type: 'tel', autocomplete: 'tel' } },
  plz: {
    label: 'PLZ',
    attrs: { type: 'text', inputmode: 'numeric', pattern: '[0-9]{5}', maxlength: 5, autocomplete: 'postal-code' },
  },
  ort: { label: 'Ort', attrs: { type: 'text', autocomplete: 'address-level2' } },
};

const { name, preset, id = `f-${name}`, required = false, hint, error, requiredText, class: className } = Astro.props;
const p = preset ? PRESETS[preset] : undefined;
const label = Astro.props.label ?? p?.label;
if (!label) throw new Error(`TextField "${name}": a label is required without a preset`);

const pick = <K extends keyof Props>(key: K) => (Astro.props[key] === undefined ? {} : { [key]: Astro.props[key] });
const attrs: HTMLAttributes<'input'> = {
  type: 'text',
  ...p?.attrs,
  ...pick('type'),
  ...pick('autocomplete'),
  ...pick('inputmode'),
  ...pick('pattern'),
  ...pick('minlength'),
  ...pick('maxlength'),
  ...pick('placeholder'),
  ...pick('value'),
};
// One message covers every way the field can fail (messages.de.ts), with and without JS.
const message =
  error ??
  defaultMessage({
    type: String(attrs.type),
    autocomplete: attrs.autocomplete ? String(attrs.autocomplete) : undefined,
    pattern: attrs.pattern ? String(attrs.pattern) : undefined,
    minLength: Number(attrs.minlength) || undefined,
  });
const fieldProps = { id, label, required, hint, error: message, ...(requiredText ? { requiredText } : {}) };
---

<Field {...fieldProps} class={className}>
  <input
    class="input"
    id={id}
    name={name}
    required={required}
    aria-describedby={describedBy(hint && `${id}-hint`)}
    {...attrs}
  />
</Field>
