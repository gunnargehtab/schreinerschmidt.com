---
// global.css must stay the FIRST import: Astro orders a page's stylesheets by cumulative import
// index, and the layer statement in global.css has to precede every component's `@layer components`.
import '../styles/global.css';
import { Font } from 'astro:assets';
import type { ComponentProps } from 'astro/types';
import { themeInitScript, vtTypesScript, speculationRulesScript } from '../lib/inline-scripts.mjs';
import { vt } from '../lib/vt';
import Seo from '../components/seo/Seo.astro';
import SiteJsonLd from '../components/seo/SiteJsonLd.astro';
import DemoBanner from '../components/layout/DemoBanner.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SkipLink from '../components/layout/SkipLink.astro';

// title / description / noindex / canonicalPath / image pass straight to <Seo>. Omit `title` on Home.
type Props = ComponentProps<typeof Seo>;

const base = import.meta.env.BASE_URL;
// Compat: 404.astro (not in this task) still passes the full "… | Schreinerei Schmidt" title; <Seo> appends the site name.
const { title, ...rest } = Astro.props;
const pageTitle = title?.replace(/ \| Schreinerei Schmidt$/, '');
// The header carries `view-transition-name: site-header` by class (motion.css); register it once per page.
vt(Astro.locals, 'site-header');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={themeInitScript} />
    <script is:inline set:html={vtTypesScript(base)} />
    <script is:inline type="speculationrules" set:html={speculationRulesScript(base)} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFBF5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#160D07" />
    <Seo title={pageTitle} {...rest} />
    <link rel="expect" href="#main" blocking="render" />
    <Font cssVariable="--font-sans" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-accent" preload={[{ subset: 'latin' }]} />
    <SiteJsonLd />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <DemoBanner />
    <SiteHeader />
    <main id="main" class="page-grid">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  @layer components {
    /*
     * Workaround: base.css (`:is(ul, ol) { padding-inline-start: 1.25em }`) sits in a later layer than
     * reset.css and so beats the `.list-plain` reset. Remove once src/styles/reset.css is fixed.
     */
    :is(ul, ol).list-plain {
      padding-inline-start: 0;
    }
  }
</style>
