---
// Referenzen overview (docs/design-system.md §8). Filter chips (CSS `:has()`, enhanced by
// referenzen-filter.ts) over all projects. Projects with a detail page link to it (`proj-<slug>`
// morphs into the detail hero). Single-photo projects open their cover in the lightbox, unless the
// photo is `cardOnly` (legacy or small): those cards stay plain, so no small photo is enlarged.
import PageLayout from '../../layouts/PageLayout.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import FilterBar from '../../components/sections/FilterBar.astro';
import Lightbox from '../../components/sections/Lightbox.astro';
import ProjectCard from '../../components/sections/ProjectCard.astro';
import { getPageCopy } from '../../lib/page-copy';
import { referenzenSchema } from '../../lib/page-copy/referenzen';
import { projectCount, uiReferenzenSchema } from '../../lib/page-copy/ui-referenzen';
import { getProjects } from '../../lib/content';
import { dataCat } from '../../lib/referenzen-filter';

const copy = await getPageCopy('referenzen', referenzenSchema);
const ui = await getPageCopy('ui', uiReferenzenSchema);
const projects = await getProjects();
---

<PageLayout title={copy.seo.title ?? copy.hero.h1} heading={copy.hero.h1} description={copy.seo.description}>
  <div class="stack" slot="lead">
    <p class="lead">{copy.hero.lead}</p>
    <p class="refs-count text-muted">{projectCount(ui, projects.length)}</p>
  </div>
  <section class="section">
    <FilterBar items={projects.map((p) => p.data)} legend={ui.filter.label} reveal>
      {projects.map((project, i) => (
        <li
          class="gallery__item"
          data-cat={dataCat(project.data.categories)}
          style={`--ar:${project.data.cover.src.width} / ${project.data.cover.src.height}`}
        >
          {/* The first card is the LCP element on phones (one column): eager with high priority. The
              others stay lazy, so on phones they don't compete with it for bandwidth; on wider
              screens the rest of the first row is in the viewport and loads right after layout. */}
          <ProjectCard
            project={project}
            level={2}
            lightbox
            loading={i === 0 ? 'eager' : 'lazy'}
            {...(i === 0 ? { fetchpriority: 'high' as const } : {})}
          />
        </li>
      ))}
    </FilterBar>
  </section>
  <CtaBand heading={copy.ctaBand.h2} lead={copy.ctaBand.text} />
  <Lightbox />
</PageLayout>

<style>
  @layer components {
    .refs-count {
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
    }

    /* Cards after the first row (docs/design-system.md §7): skipped until near the viewport, so their
       lazy images don't load during the first render alongside the LCP card. */
    .gallery__item:nth-child(n + 4) {
      content-visibility: auto;
      contain-intrinsic-size: auto 22rem;
    }
  }
</style>
