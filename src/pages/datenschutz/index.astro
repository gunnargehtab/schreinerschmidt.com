---
// Datenschutzerklärung (docs/architecture.md §9). The Markdown template in src/content/legal/datenschutz.md is
// resolved against the settings (tokens, demo/production blocks) and rendered at build time by
// renderLegal(); unconfirmed facts show as review marks, never as invented values.
import { getEntry } from 'astro:content';
import { PUBLIC_DEMO } from 'astro:env/client';
import PageLayout from '../../layouts/PageLayout.astro';
import InPageNav from '../../components/sections/InPageNav.astro';
import ReviewMark from '../../components/ui/ReviewMark.astro';
import { getSite } from '../../lib/content';
import { formatDate, isoDate } from '../../lib/format';
import { renderLegal } from '../../lib/legal-tokens';
import { getPageCopy } from '../../lib/page-copy';
import { uiFormsSchema } from '../../lib/page-copy/ui-forms';

const entry = await getEntry('legal', 'datenschutz');
if (!entry) throw new Error('Legal entry "datenschutz" is missing (src/content/legal/datenschutz.md)');
const ui = await getPageCopy('ui', uiFormsSchema);
const site = await getSite();
const { html, headings } = await renderLegal(entry.body ?? '', {
  site,
  demo: PUBLIC_DEMO,
  base: import.meta.env.BASE_URL,
});
const { title, seo, stand, review } = entry.data;
const pending = PUBLIC_DEMO && review.status !== 'confirmed';
---

<PageLayout title={seo.title} heading={title} description={seo.description}>
  <section class="section legal">
    <div class="stack stack--m">
      <div class="legal__meta cluster">
        {pending && (
          <p>
            <ReviewMark status={review.status === 'placeholder' ? 'placeholder' : 'needs-review'} note={review.note}>
              <strong class="legal__pending">{ui.demoBanner.legalPending}</strong>
            </ReviewMark>
          </p>
        )}
        <p>
          Stand: <time datetime={isoDate(stand)}>{formatDate(stand)}</time>
        </p>
      </div>
      <div class="legal__layout">
        <InPageNav label="Inhalt" items={headings.map((h) => ({ id: h.slug, label: h.text }))} />
        <div class="prose legal__body" set:html={html} />
      </div>
    </div>
  </section>
</PageLayout>

<style>
  @layer components {
    .legal__meta {
      color: var(--ink-muted);
      font-size: var(--step--1);
    }

    /* Narrow: the table of contents (chips) sits above the text; wide: sticky sidebar on the left. */
    .legal__layout {
      display: grid;
      gap: var(--space-m) var(--space-xl);
    }

    @container section (inline-size >= 64rem) {
      .legal__layout {
        grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr);
      }
    }

    .legal__pending {
      color: var(--ink);
    }

    /* The Markdown HTML is injected, so its elements need :global. */
    .legal__body :global(h2) {
      font-size: var(--step-1);
      scroll-margin-block-start: calc(var(--header-sticky-h, 0px) + var(--space-s));
    }

    .legal__body :global(ul) {
      padding-inline-start: 1.25em;
      list-style: disc;
    }

    .legal__body :global(.review-mark) {
      overflow-wrap: anywhere;
    }

    :global(:root[data-pruefen]) .legal__body :global(.review-mark) {
      background: var(--accent-tint);
      outline: var(--hairline) dashed var(--error);
      outline-offset: 1px;
    }

    :global(:root[data-pruefen]) .legal__body :global(.review-mark[data-review='placeholder']) {
      outline-style: solid;
      outline-width: 2px;
    }

    :global(:root[data-pruefen]) .legal__body :global(.review-mark)::after {
      content: ' [prüfen]';
      content: ' [prüfen]' / '';
      font-size: var(--step--2);
      color: var(--error);
    }

    :global(:root[data-pruefen]) .legal__body :global(.review-mark[data-review='placeholder'])::after {
      content: ' [Platzhalter]';
      content: ' [Platzhalter]' / '';
    }
  }
</style>
