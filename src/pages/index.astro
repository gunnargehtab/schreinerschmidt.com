---
// Home (docs/design-system.md §8): hero and stats from wave A; wave B assembles sections 4–12
// below. The placeholder block stays until then so the page keeps its links. Exactly one h1,
// rendered by HomeHero.
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import StatCounter from '../components/sections/StatCounter.astro';
import { url } from '../lib/url';
---

<BaseLayout description="Schreinerei Schmidt in Mannheim: Möbel nach Maß, Böden, Fenster und Türen vom Schreinermeister. Beratung, Aufmaß und Montage aus einer Hand.">
  <HomeHero />
  <StatCounter />
  <section class="section section--alt">
    <div class="stack stack--m">
      <h2>Weitere Inhalte folgen</h2>
      <p class="lead">
        Diese Startseite ist noch ein technischer Platzhalter. Leistungen, Ablauf, Referenzen und Konfigurator folgen in
        den nächsten Schritten.
      </p>
      <ul class="cluster list-plain">
        <li>
          <a class="btn btn--secondary" href={url('leistungen/boeden/')}>
            Böden
          </a>
        </li>
        <li>
          <a class="btn btn--primary" href={url('kontakt/')}>
            Kontakt
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
