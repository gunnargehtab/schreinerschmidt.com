---
import PageLayout from '../../layouts/PageLayout.astro';
import { url } from '../../lib/url';
---

<PageLayout
  title="Angebot konfigurieren"
  description="Konfigurieren Sie Möbel oder Böden online und fordern Sie ein unverbindliches Angebot der Schreinerei Schmidt an. Der Konfigurator entsteht gerade."
>
  <p class="lead" slot="lead">
    In wenigen Schritten zum individuellen Angebot.
  </p>
  <section class="section">
    <div class="prose">
      <p>Diese Seite entsteht gerade.</p>
      <p>
        <a href={url('leistungen/')}>Zu den Leistungen</a> · <a href={url('kontakt/')}>Kontakt</a>
      </p>
    </div>
  </section>
</PageLayout>
