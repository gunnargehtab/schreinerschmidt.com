---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { key: service.data.key }, props: { service } }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;
const { title, teaser, seo } = service.data;
---

<PageLayout
  title={seo.title}
  heading={title}
  description={seo.description}
  crumbs={[{ label: 'Leistungen', href: 'leistungen/' }, { label: title }]}
>
  <p class="lead" slot="lead">
    {teaser}
  </p>
  <section class="section">
    <div class="prose">
      <p>Diese Seite entsteht gerade.</p>
      <p>
        <a href={url('leistungen/')}>Alle Leistungen</a> · <a href={url('kontakt/')}>Kontakt</a>
      </p>
    </div>
  </section>
</PageLayout>
