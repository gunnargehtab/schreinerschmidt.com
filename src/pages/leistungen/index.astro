---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Leistungen"
  description="Leistungen der Schreinerei Schmidt in Mannheim: Möbel nach Maß, Böden, Treppen, Fenster, Türen, Altbausanierung und Terrassen. Die Seite entsteht gerade."
>
  <p class="lead" slot="lead">
    Sieben Leistungen aus einer Hand: Beratung, Aufmaß, Fertigung und Montage.
  </p>
  <section class="section">
    <div class="stack stack--m">
      <p>Diese Seite entsteht gerade.</p>
      <ul class="stack list-plain">
        {services.map(({ data }) => (
          <li>
            <a href={url(`leistungen/${data.key}/`)}>{data.title}</a>
            <span class="text-muted"> – {data.teaser}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</PageLayout>
